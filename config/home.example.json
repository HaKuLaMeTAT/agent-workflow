{
  "schema_version": 1,
  "host_id": "example-host",
  "catalog": "roles.json",
  "providers": {
    "codex-local": {
      "adapter": "codex",
      "executable": "codex",
      "args": [],
      "auth": "cli-managed",
      "models": {
        "gpt-6-astra": [
          "low",
          "medium",
          "high",
          "xhigh"
        ]
      },
      "inherit_env": []
    },
    "claude-local": {
      "adapter": "claude",
      "executable": "claude",
      "args": [],
      "auth": "cli-managed",
      "models": {
        "claude-opus-5": [
          "low",
          "medium",
          "high",
          "max"
        ],
        "claude-sonnet-5": [
          "low",
          "medium",
          "high",
          "max"
        ]
      },
      "inherit_env": []
    }
  },
  "bindings": {
    "designer": {
      "provider": "claude-local",
      "model": "claude-opus-5",
      "effort": "high",
      "enabled": true
    },
    "developer-basic": {
      "provider": "codex-local",
      "model": "gpt-6-astra",
      "effort": "low",
      "enabled": true
    },
    "developer-main": {
      "provider": "codex-local",
      "model": "gpt-6-astra",
      "effort": "medium",
      "enabled": true
    },
    "developer-hard": {
      "provider": "codex-local",
      "model": "gpt-6-astra",
      "effort": "xhigh",
      "enabled": true
    },
    "reviewer": {
      "provider": "claude-local",
      "model": "claude-sonnet-5",
      "effort": "high",
      "enabled": true
    },
    "analyst-primary": {
      "provider": "codex-local",
      "model": "gpt-6-astra",
      "effort": "medium",
      "enabled": true
    },
    "analyst-peer": {
      "provider": "claude-local",
      "model": "claude-sonnet-5",
      "effort": "high",
      "enabled": true
    }
  },
  "limits": {
    "max_active_workers": 2,
    "default_timeout_seconds": 1200,
    "summary_max_chars": 4000,
    "result_page_max_chars": 8000
  }
}
