{
  "schema_version": 1,
  "host_id": "example-host",
  "catalog": "roles.json",
  "providers": {
    "codex-local": {
      "adapter": "codex",
      "executable": "codex",
      "args": [],
      "auth": "cli-managed",
      "inherit_env": []
    },
    "claude-local": {
      "adapter": "claude",
      "executable": "claude",
      "args": [],
      "auth": "cli-managed",
      "models": {
        "claude-opus-5": [
          "low",
          "medium",
          "high",
          "max"
        ],
        "claude-sonnet-5": [
          "low",
          "medium",
          "high",
          "max"
        ]
      },
      "inherit_env": []
    }
  },
  "bindings": {
    "executor": {
      "provider": "claude-local",
      "model": "claude-sonnet-5",
      "effort": "high",
      "enabled": true
    },
    "designer": {
      "provider": "claude-local",
      "model": "claude-opus-5",
      "effort": "high",
      "enabled": true
    },
    "developer-basic": {
      "enabled": true,
      "execution": "host"
    },
    "developer-main": {
      "enabled": true,
      "execution": "host"
    },
    "developer-hard": {
      "enabled": true,
      "execution": "worker",
      "access": "workspace-write",
      "permissions": "restricted",
      "provider": "claude-local",
      "model": "claude-opus-5",
      "effort": "high"
    },
    "reviewer": {
      "provider": "claude-local",
      "model": "claude-sonnet-5",
      "effort": "high",
      "enabled": true
    },
    "analyst-primary": {
      "enabled": true,
      "execution": "host"
    },
    "analyst-peer": {
      "provider": "claude-local",
      "model": "claude-sonnet-5",
      "effort": "high",
      "enabled": true
    }
  },
  "limits": {
    "max_active_workers": 2,
    "default_timeout_seconds": 1200,
    "summary_max_chars": 4000,
    "result_page_max_chars": 8000
  },
  "routing": {
    "enabled": true,
    "escalate_after": 2,
    "max_delegations": 3
  }
}
