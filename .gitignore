# Publish only the source and public documentation listed below.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/package.json
!/package-lock.json
!/.github/
!/bin/
!/src/
!/ui/
!/config/
!/roles/
!/scripts/
!/skills/
!/patches/
!/tests/
!/docs/
/docs/*
!/docs/INSTALL.md
!/docs/UPSTREAM.md
/config/*
!/config/*.example.json
!/config/roles.json
node_modules/
*.log
.env
.env.*
*.key
*.pem
